# ☿ FREDDY Hg — Variables de entorno (PLANTILLA)
# Copiar a `.env` y rellenar con valores reales.
# NUNCA hacer commit del archivo `.env`.

# ─── GOOGLE EARTH ENGINE ────────────────────────────────────────────
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_KEY_PATH=./secrets/gee-service-account.json

# ─── SUPABASE ───────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── MAPBOX ─────────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ─── TWILIO (WhatsApp Sandbox o Business) ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TEST_WHATSAPP_NUMBER=

# ─── MISTRAL AI (via OpenRouter o directo) ──────────────────────────
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://openrouter.ai/api/v1
MISTRAL_MODEL=mistralai/mistral-small-24b-instruct-2501

# ─── BACKEND ─────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
BACKEND_URL=http://localhost:8000

# ─── FRONTEND (Vite) ─────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAPBOX_TOKEN=
VITE_BACKEND_URL=http://localhost:8000

# ─── MAKE.COM (Scheduler) ────────────────────────────────────────────
MAKE_PIPELINE_WEBHOOK_URL=
