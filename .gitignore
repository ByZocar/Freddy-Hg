.vercel/
.railway/

# Test outputs (sandbox local solamente — no incluir resultados de pruebas en git)
06_pruebas/test_logs/*.json
06_pruebas/sample_alerts/*.json
06_pruebas/screenshots/*.png
06_pruebas/screenshots/*.jpg
!06_pruebas/**/README.md
!06_pruebas/**/.gitkeep
