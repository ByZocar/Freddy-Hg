.env
.env.local
.env.*.local
secrets/
*.json.key
*-service-account.json
*-key.json
gee-service-account.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.py.class
.venv/
venv/
env/
.python-version
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node / Frontend
node_modules/
dist/
.vite/
*.local
.next/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
*.code-workspace
.idea/
.cursor/

